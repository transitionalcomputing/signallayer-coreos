#!/usr/bin/env python3
"""Compare deterministic CoreOS source inventory with an accepted baseline."""

from __future__ import annotations

import argparse
import hashlib
import json
import re
import shlex
import subprocess
import sys
import tomllib
import xml.etree.ElementTree as ET
from pathlib import Path


SCHEMA_VERSION = 1
DEFAULT_BASELINE = Path("config/coreos-source-inventory.json")
UNIT_SUFFIXES = (".service", ".socket", ".timer", ".path", ".target", ".mount")
PROTECTED_RUNTIME_PREFIXES = (
    "/usr/bin/",
    "/usr/libexec/signallayer/",
    "/usr/lib/signallayer/",
    "/usr/lib/systemd/system/",
    "/etc/systemd/system/",
    "/usr/share/dbus-1/",
    "/etc/dbus-1/",
    "/usr/lib/sysusers.d/",
    "/etc/sysusers.d/",
    "/usr/lib/tmpfiles.d/",
    "/usr/share/selinux/",
    "/etc/selinux/",
)
PACKAGE_MANAGERS = ("dnf", "dnf5", "microdnf", "yum", "apt", "apt-get", "apk", "rpm", "rpm-ostree")
MUTATING_COMMANDS = {
    "bash",
    "cat",
    "chmod",
    "chown",
    "chcon",
    "cp",
    "dd",
    "echo",
    "install",
    "ln",
    "mkdir",
    "mv",
    "perl",
    "printf",
    "python",
    "python3",
    "rm",
    "rmdir",
    "sed",
    "semanage",
    "semodule",
    "sh",
    "tee",
    "touch",
    "truncate",
}
SUPPORTED_RUN_COMMANDS = {
    "}",
    "awk",
    "case",
    "chmod",
    "dnf",
    "esac",
    "exit",
    "find",
    "grep",
    "install",
    "ln",
    "printf",
    "rm",
    "rmdir",
    "sed",
    "semodule",
    "set",
    "systemctl",
    "test",
    "tr",
}
REVIEWED_COPY_EXCEPTIONS = {
    "/usr/lib/systemd/system/udisks2.service.d/10-polkit-order.conf": {
        "source": "image/platform/udisks2-polkit.conf",
        "sha256": "7798a6fe37e70c0e442b0ff84813662d5285624aaf3b4dc275c0e3542dfe0172",
    },
    "/usr/lib/tmpfiles.d/sl-bootc-runtime.conf": {
        "source": "image/platform/sl-bootc-runtime.conf",
        "sha256": "b9b288a3286cb030fe0541df86cc6429f3a0c2c65afb3f1d6c56811b12aedf62",
    },
    "/usr/share/selinux/packages/sl_platformd.pp": {
        "source": "/policy/sl_platformd.pp",
        "from": "--from=policy-build",
    },
}


class InventoryError(Exception):
    pass


def read(path: Path) -> str:
    try:
        return path.read_text()
    except OSError as error:
        raise InventoryError(f"cannot read {path}: {error}") from error


def digest(path: Path) -> str:
    try:
        return hashlib.sha256(path.read_bytes()).hexdigest()
    except OSError as error:
        raise InventoryError(f"cannot hash {path}: {error}") from error


def logical_lines(text: str) -> list[str]:
    result: list[str] = []
    current = ""
    for raw in text.splitlines():
        stripped = raw.strip()
        if not stripped or stripped.startswith("#"):
            continue
        current = f"{current} {stripped}".strip()
        if current.endswith("\\"):
            current = current[:-1].rstrip()
        else:
            result.append(current)
            current = ""
    if current:
        result.append(current)
    return result


def parse_copy(root: Path, line: str) -> dict[str, str]:
    body = line.removeprefix("COPY ").strip()
    if body.startswith("["):
        raise InventoryError(f"unsupported runtime COPY JSON form: {line}")
    try:
        tokens = shlex.split(line)
    except ValueError as error:
        raise InventoryError(f"cannot parse runtime COPY instruction: {line}: {error}") from error
    flags = [token for token in tokens[1:] if token.startswith("--")]
    if len(flags) > 1 or any(not token.startswith("--from=") or not token.removeprefix("--from=") for token in flags):
        raise InventoryError(f"unsupported runtime COPY flag or form: {line}")
    values = [token for token in tokens[1:] if not token.startswith("--")]
    if len(values) != 2:
        raise InventoryError(f"runtime COPY must have exactly one source and one destination: {line}")
    source, destination = values
    if not destination.startswith("/") or any(character in destination for character in "*?["):
        raise InventoryError(f"unsupported runtime COPY destination: {line}")
    from_stage = bool(flags)
    if (
        source == "-"
        or source.startswith(("http://", "https://", "git://", "ssh://"))
        or any(character in source for character in "*?[")
        or (not from_stage and (source.startswith("/") or ".." in Path(source).parts))
    ):
        raise InventoryError(f"unsupported runtime COPY source: {line}")
    supported_destination = (
        destination.startswith("/usr/bin/")
        or destination.startswith("/usr/libexec/signallayer/")
        or destination.startswith("/usr/lib/sysusers.d/")
        or destination.startswith("/usr/share/dbus-1/system.d/")
        or destination.startswith("/usr/share/dbus-1/system-services/")
        or (
            destination.startswith("/usr/lib/systemd/system/")
            and (
                destination.endswith(UNIT_SUFFIXES)
                or destination == "/usr/lib/systemd/system/udisks2.service.d/10-polkit-order.conf"
            )
        )
        or destination == "/usr/lib/tmpfiles.d/sl-bootc-runtime.conf"
        or destination == "/usr/share/selinux/packages/sl_platformd.pp"
    )
    if not supported_destination:
        raise InventoryError(f"unsupported runtime COPY destination outside the reviewed grammar: {line}")
    source_path = root / source
    if not from_stage and not source_path.is_file():
        raise InventoryError(f"runtime COPY source is not a maintained file: {line}")
    if destination in REVIEWED_COPY_EXCEPTIONS:
        expected = REVIEWED_COPY_EXCEPTIONS[destination]
        if source != expected["source"] or ("from" in expected and flags != [expected["from"]]):
            raise InventoryError(f"runtime COPY does not match the reviewed fixed input: {line}")
        if "sha256" in expected and digest(source_path) != expected["sha256"]:
            raise InventoryError(f"reviewed runtime COPY input changed without inventory approval: {source}")
    record = {"source": source, "destination": destination}
    if source_path.is_file():
        record["sha256"] = digest(source_path)
    return record


def copy_mappings(root: Path, stage: str) -> list[dict[str, str]]:
    records: list[dict[str, str]] = []
    for line in logical_lines(stage):
        if not line.startswith("COPY "):
            continue
        records.append(parse_copy(root, line))
    return records


def final_stage(containerfile: str) -> tuple[str, str]:
    matches = list(re.finditer(r"^FROM\s+(\S+).*$", containerfile, re.MULTILINE))
    if not matches:
        raise InventoryError("Containerfile has no FROM instruction")
    start = matches[-1]
    return start.group(1), containerfile[start.end() :]


def runtime_packages(stage: str) -> list[str]:
    packages: set[str] = set()
    joined = "\n".join(logical_lines(stage))
    for match in re.finditer(r"\bdnf\s+-y\s+install\s+(.*?)(?:\s*&&|\s*;|$)", joined):
        for token in shlex.split(match.group(1)):
            if not token.startswith("-") and "$" not in token:
                packages.add(token)
    return sorted(packages)


def command_segments(body: str) -> list[str]:
    return [segment.strip() for segment in re.split(r"\s*(?:&&|\|\||;)\s*", body) if segment.strip()]


def command_name(segment: str) -> str:
    candidate = segment.lstrip("{(! ")
    if candidate.startswith("command "):
        candidate = candidate.removeprefix("command ").lstrip()
    return candidate.split(maxsplit=1)[0] if candidate else ""


def validate_package_commands(line: str) -> None:
    body = line.removeprefix("RUN ")
    manager_pattern = r"(?:^|[;&|]\s*)(?:command\s+)?(" + "|".join(re.escape(name) for name in PACKAGE_MANAGERS) + r")\b"
    managers = re.findall(manager_pattern, body)
    if not managers:
        return
    approved = re.fullmatch(
        r"dnf -y install --setopt=install_weak_deps=False "
        r"([A-Za-z0-9_.+:-]+(?: [A-Za-z0-9_.+:-]+)*) && dnf clean all(?: && .+)?",
        body,
    )
    if managers != ["dnf", "dnf"] or approved is None:
        raise InventoryError(f"unsupported runtime package operation: {line}")


def allowed_runtime_mutation(segment: str) -> bool:
    normalized = segment.lstrip("{ ")
    if normalized in {
        "install -d -m 0755 /usr/lib/signallayer",
        "install -d -m 0755 /usr/lib/signallayer/openssl.d",
        "install -m 0644 /etc/pki/tls/openssl.d/pkcs11-provider.conf /usr/lib/signallayer/openssl.d/",
        "chmod 0644 /usr/lib/signallayer/openssl.cnf",
        "semodule -n -i /usr/share/selinux/packages/sl_platformd.pp",
        "install -d /usr/lib/systemd/system/multi-user.target.wants",
        "install -d /etc/systemd/system",
        "rm -rf -- /run/dnf /var/cache/libdnf5 /var/lib/dnf/repos",
        "rm -f -- /var/log/dnf5.log /var/cache/ldconfig/aux-cache",
        "rm -f /usr/bin/semodule_expand /usr/bin/semodule_link /usr/bin/semodule_package /usr/bin/semodule_unpackage /usr/share/selinux/devel/include/services/container.if /usr/share/selinux/devel/include/distributed/passt.if",
        "rmdir /usr/share/selinux/devel/include/services /usr/share/selinux/devel/include/distributed /usr/share/selinux/devel/include /usr/share/selinux/devel",
    }:
        return True
    if normalized.startswith("sed ") and normalized.endswith("> /usr/lib/signallayer/openssl.cnf"):
        return True
    if normalized.startswith("printf ") and normalized.endswith("> /usr/lib/signallayer/release"):
        return True
    if re.fullmatch(r"ln -s \S+ /(?:usr/lib|etc)/systemd/system/\S+\}?", normalized):
        return True
    return False


def allowed_runtime_reference(segment: str) -> bool:
    normalized = segment.lstrip("{ ")
    if normalized.startswith(("test ", "[ ", "grep ", "awk ", "tr ", "readlink ", "! ")):
        return True
    return allowed_runtime_mutation(segment)


def validate_run_instruction(line: str) -> None:
    validate_package_commands(line)
    body = line.removeprefix("RUN ")
    if re.search(r"(?:^|[;&|]\s*)(?:useradd|groupadd|usermod|groupmod|systemd-sysusers)\b", body):
        raise InventoryError(f"unsupported runtime identity operation: {line}")
    for match in re.finditer(r"(?:^|[;&|]\s*)systemctl\s+(\S+)", body):
        if match.group(1) not in {"enable", "disable", "mask", "unmask", "preset"}:
            raise InventoryError(f"unsupported runtime systemd activation operation: {line}")
    for segment in command_segments(body):
        name = command_name(segment)
        if name in MUTATING_COMMANDS and not allowed_runtime_mutation(segment):
            raise InventoryError(f"unsupported runtime mutation command: {segment}")
        if name not in SUPPORTED_RUN_COMMANDS:
            raise InventoryError(f"unsupported runtime command: {segment}")
        if not any(prefix in segment for prefix in PROTECTED_RUNTIME_PREFIXES):
            continue
        if not allowed_runtime_reference(segment):
            raise InventoryError(f"unsupported operation touching a protected runtime surface: {segment}")


def validate_runtime_grammar(root: Path, stage: str) -> None:
    supported_instructions = {"ARG", "LABEL", "RUN", "COPY"}
    for line in logical_lines(stage):
        instruction = line.split(maxsplit=1)[0]
        if instruction == "ADD":
            raise InventoryError(f"ADD is not supported in the runtime stage: {line}")
        if instruction not in supported_instructions:
            raise InventoryError(f"unsupported runtime-stage instruction: {line}")
        if instruction == "COPY":
            parse_copy(root, line)
        elif instruction == "RUN":
            validate_run_instruction(line)


def installed_files(root: Path, mappings: list[dict[str, str]], prefix: str) -> dict[str, dict[str, str]]:
    result: dict[str, dict[str, str]] = {}
    for record in mappings:
        destination = record["destination"]
        if destination.startswith(prefix):
            result[destination] = record
    return dict(sorted(result.items()))


def dbus_rules(root: Path, files: dict[str, dict[str, str]]) -> dict[str, list[dict[str, object]]]:
    result: dict[str, list[dict[str, object]]] = {}
    for destination, record in files.items():
        source = root / record["source"]
        if not source.is_file() or source.suffix != ".conf":
            continue
        try:
            tree = ET.parse(source)
        except ET.ParseError as error:
            raise InventoryError(f"invalid D-Bus policy {record['source']}: {error}") from error
        policies: list[dict[str, object]] = []
        for policy in tree.findall("policy"):
            rules = [
                {"action": child.tag, **dict(sorted(child.attrib.items()))}
                for child in policy
                if child.tag in {"allow", "deny"}
            ]
            policies.append({"selector": dict(sorted(policy.attrib.items())), "rules": rules})
        result[destination] = policies
    return result


def sysusers_entries(root: Path, files: dict[str, dict[str, str]]) -> dict[str, list[str]]:
    result: dict[str, list[str]] = {}
    for destination, record in files.items():
        source = root / record["source"]
        entries = [line.strip() for line in read(source).splitlines() if line.strip() and not line.lstrip().startswith("#")]
        result[destination] = entries
    return result


def cargo_components(root: Path) -> dict[str, dict[str, str]]:
    try:
        with (root / "Cargo.toml").open("rb") as stream:
            workspace = tomllib.load(stream)["workspace"]
        workspace_version = str(workspace["package"]["version"])
        members = workspace["members"]
    except (OSError, KeyError, TypeError, tomllib.TOMLDecodeError) as error:
        raise InventoryError(f"cannot read Cargo workspace: {error}") from error
    result: dict[str, dict[str, str]] = {}
    for member in members:
        manifest_path = root / member / "Cargo.toml"
        try:
            with manifest_path.open("rb") as stream:
                package = tomllib.load(stream)["package"]
            version = workspace_version if package["version"] == {"workspace": True} else str(package["version"])
            result[str(package["name"])] = {"path": str(member), "version": version}
        except (OSError, KeyError, TypeError, tomllib.TOMLDecodeError) as error:
            raise InventoryError(f"cannot read Cargo component {member}: {error}") from error
    return dict(sorted(result.items()))


def selinux_inputs(root: Path) -> dict[str, str]:
    policy = root / "image/platform/selinux"
    if not policy.is_dir():
        raise InventoryError("missing SELinux policy input directory")
    return {
        str(path.relative_to(root)): digest(path)
        for path in sorted(policy.rglob("*"))
        if path.is_file()
    }


def systemd_operations(stage: str) -> list[str]:
    operations: set[str] = set()
    for line in logical_lines(stage):
        for match in re.finditer(r"\bsystemctl\s+(?:enable|disable|mask|unmask|preset)\s+([^;&]+)", line):
            operations.add(" ".join(match.group(0).split()))
        for match in re.finditer(r"\bln\s+-s\s+(\S+)\s+(\S*systemd/system/\S+)", line):
            operations.add(f"ln -s {match.group(1)} {match.group(2).rstrip(';&')}")
    return sorted(operations)


def source_commit(root: Path) -> str:
    result = subprocess.run(
        ["git", "-C", str(root), "rev-parse", "HEAD"],
        text=True,
        stdout=subprocess.PIPE,
        stderr=subprocess.DEVNULL,
    )
    return result.stdout.strip() if result.returncode == 0 else "unavailable"


def collect(root: Path) -> dict[str, object]:
    containerfile = read(root / "Containerfile")
    base, stage = final_stage(containerfile)
    validate_runtime_grammar(root, stage)
    mappings = copy_mappings(root, stage)
    units = {
        path: value
        for path, value in installed_files(root, mappings, "/usr/lib/systemd/system/").items()
        if path.endswith(UNIT_SUFFIXES)
    }
    dbus = {
        **installed_files(root, mappings, "/usr/share/dbus-1/system.d/"),
        **installed_files(root, mappings, "/usr/share/dbus-1/system-services/"),
    }
    sysusers = installed_files(root, mappings, "/usr/lib/sysusers.d/")
    executables = {
        **installed_files(root, mappings, "/usr/bin/"),
        **installed_files(root, mappings, "/usr/libexec/signallayer/"),
    }
    return {
        "runtime_base_image": base,
        "runtime_packages_declared": runtime_packages(stage),
        "systemd_units": units,
        "systemd_operations": systemd_operations(stage),
        "dbus_files": dict(sorted(dbus.items())),
        "dbus_policy_rules": dbus_rules(root, dbus),
        "sysusers_files": dict(sorted(sysusers.items())),
        "sysusers_entries": sysusers_entries(root, sysusers),
        "cargo_components": cargo_components(root),
        "selinux_policy_inputs": selinux_inputs(root),
        "coreos_executables": dict(sorted(executables.items())),
    }


def compare(expected: dict[str, object], actual: dict[str, object]) -> list[dict[str, object]]:
    differences: list[dict[str, object]] = []

    def walk(left: object, right: object, path: str) -> None:
        if isinstance(left, dict) and isinstance(right, dict):
            for key in sorted(left.keys() - right.keys()):
                differences.append({"kind": "removed", "path": f"{path}.{key}".lstrip("."), "expected": left[key]})
            for key in sorted(right.keys() - left.keys()):
                differences.append({"kind": "added", "path": f"{path}.{key}".lstrip("."), "actual": right[key]})
            for key in sorted(left.keys() & right.keys()):
                walk(left[key], right[key], f"{path}.{key}".lstrip("."))
            return
        if isinstance(left, list) and isinstance(right, list):
            old = {json.dumps(item, sort_keys=True, separators=(",", ":")): item for item in left}
            new = {json.dumps(item, sort_keys=True, separators=(",", ":")): item for item in right}
            for key in sorted(old.keys() - new.keys()):
                differences.append({"kind": "removed", "path": f"{path}[]", "expected": old[key]})
            for key in sorted(new.keys() - old.keys()):
                differences.append({"kind": "added", "path": f"{path}[]", "actual": new[key]})
            return
        if left != right:
            differences.append({"kind": "changed", "path": path, "expected": left, "actual": right})

    walk(expected, actual, "")
    return differences


def document(root: Path, approval: str) -> dict[str, object]:
    key = "accepted_source" if approval == "accepted" else "candidate_source"
    return {
        "schema_version": SCHEMA_VERSION,
        "approval_status": approval,
        key: source_commit(root),
        "scope": "source-declared CoreOS inventory; installed-artifact inventory is UNPROVEN",
        "inventory": collect(root),
    }


def parse_args(argv: list[str]) -> argparse.Namespace:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--root", type=Path, default=Path.cwd())
    parser.add_argument("--baseline", type=Path)
    parser.add_argument("--format", choices=("human", "json"), default="human")
    parser.add_argument("--candidate-output", type=Path)
    return parser.parse_args(argv)


def main(argv: list[str] | None = None) -> int:
    args = parse_args(sys.argv[1:] if argv is None else argv)
    root = args.root.resolve()
    baseline = (args.baseline or root / DEFAULT_BASELINE).resolve()
    try:
        if args.candidate_output:
            output = args.candidate_output.resolve()
            if output == baseline:
                raise InventoryError("refusing to overwrite the accepted baseline; generate an unapproved candidate elsewhere")
            if output.exists():
                raise InventoryError(f"refusing to overwrite existing candidate output: {output}")
            output.parent.mkdir(parents=True, exist_ok=True)
            output.write_text(json.dumps(document(root, "unapproved"), indent=2, sort_keys=True) + "\n")
            print(f"coreos-inventory: wrote UNAPPROVED candidate to {output}")
            return 0

        try:
            accepted = json.loads(read(baseline))
        except json.JSONDecodeError as error:
            raise InventoryError(f"invalid baseline JSON: {error}") from error
        if accepted.get("schema_version") != SCHEMA_VERSION:
            raise InventoryError("unsupported baseline schema")
        if accepted.get("approval_status") != "accepted":
            raise InventoryError("baseline is not explicitly marked accepted")
        actual = collect(root)
        differences = compare(accepted.get("inventory", {}), actual)
        result = {
            "status": "pass" if not differences else "fail",
            "baseline": str(baseline.relative_to(root)) if baseline.is_relative_to(root) else str(baseline),
            "baseline_source": accepted.get("accepted_source"),
            "source": source_commit(root),
            "differences": differences,
            "installed_artifact_inventory": "unproven",
        }
    except InventoryError as error:
        if args.format == "json":
            print(json.dumps({"status": "error", "error": str(error)}, indent=2, sort_keys=True))
        else:
            print(f"coreos-inventory: ERROR: {error}", file=sys.stderr)
        return 2

    if args.format == "json":
        print(json.dumps(result, indent=2, sort_keys=True))
    elif differences:
        print(f"coreos-inventory: FAIL: {len(differences)} unapproved change(s)")
        for difference in differences:
            print(f"{difference['kind']}: {difference['path']}")
    else:
        print("coreos-inventory: PASS: source-declared inventory matches accepted baseline")
        print("installed-artifact inventory: UNPROVEN")
    return 1 if differences else 0


if __name__ == "__main__":
    raise SystemExit(main())
