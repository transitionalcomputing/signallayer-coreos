#!/usr/bin/env python3
"""Create or verify a trusted-host OCI release evidence record."""

from __future__ import annotations

import argparse
import json
import re
import sys
from pathlib import Path


SCHEMA = "org.signallayer.release-evidence.v1"
SHA256_ID = re.compile(r"sha256:[0-9a-f]{64}\Z")
COMMIT = re.compile(r"[0-9a-f]{40}\Z")
HEX256 = re.compile(r"[0-9a-f]{64}\Z")
OS_VERSION = re.compile(r"(?:0|[1-9][0-9]*)\.(?:0|[1-9][0-9]*)\.(?:0|[1-9][0-9]*)(?:\.(?:0|[1-9][0-9]*))?\Z")


class EvidenceError(Exception):
    pass


def load_json(path: Path) -> object:
    try:
        return json.loads(path.read_text())
    except (OSError, json.JSONDecodeError) as error:
        raise EvidenceError(f"cannot read valid JSON from {path}: {error}") from error


def inspection(path: Path) -> dict[str, object]:
    value = load_json(path)
    if isinstance(value, list) and len(value) == 1:
        value = value[0]
    if not isinstance(value, dict):
        raise EvidenceError("Podman inspection must be one JSON object")
    image_id = value.get("Id")
    if not isinstance(image_id, str) or not SHA256_ID.fullmatch(image_id):
        raise EvidenceError("inspection has no valid immutable image ID")
    config = value.get("Config")
    labels = config.get("Labels") if isinstance(config, dict) else None
    if not isinstance(labels, dict):
        labels = value.get("Labels")
    if not isinstance(labels, dict) or not all(isinstance(key, str) and isinstance(item, str) for key, item in labels.items()):
        raise EvidenceError("inspection has no valid label map")
    return {
        "image_id": image_id,
        "digest": value.get("Digest") if isinstance(value.get("Digest"), str) and value.get("Digest") else None,
        "repo_digests": sorted(item for item in value.get("RepoDigests", []) if isinstance(item, str)),
        "labels": labels,
    }


def expected_build_id(version: str, source: str) -> str:
    if not COMMIT.fullmatch(source):
        raise EvidenceError("source commit must be exactly 40 lowercase hexadecimal characters")
    return f"{version}-{source[:12]}-release"


def validate_identity(observed: dict[str, object], version: str, source: str, build_id: str) -> None:
    labels = observed["labels"]
    assert isinstance(labels, dict)
    required = {
        "containers.bootc": "1",
        "org.opencontainers.image.title": "SignalLayerIT CoreOS",
        "org.opencontainers.image.version": version,
        "org.opencontainers.image.revision": source,
        "org.signallayer.image.build-id": build_id,
    }
    for name, expected in required.items():
        actual = labels.get(name)
        if actual != expected:
            raise EvidenceError(f"output label {name}: expected {expected!r}, found {actual!r}")
    if build_id != expected_build_id(version, source):
        raise EvidenceError(f"BUILD_ID: expected {expected_build_id(version, source)!r}, found {build_id!r}")


def create(args: argparse.Namespace) -> None:
    if not OS_VERSION.fullmatch(args.planned_version):
        raise EvidenceError("planned OS version is invalid")
    if not args.image_reference:
        raise EvidenceError("image reference is empty")
    if not COMMIT.fullmatch(args.source_commit):
        raise EvidenceError("source commit must be exactly 40 lowercase hexadecimal characters")
    for name in ("containerfile_sha256", "wrapper_sha256"):
        if not HEX256.fullmatch(getattr(args, name)):
            raise EvidenceError(f"{name} is not a SHA-256 value")
    observed = inspection(args.inspection)
    validate_identity(observed, args.planned_version, args.source_commit, args.build_id)
    if args.output.exists():
        raise EvidenceError(f"refusing to overwrite release evidence: {args.output}")
    record = {
        "schema": SCHEMA,
        "release_intent": True,
        "planned_os_version": args.planned_version,
        "source_commit": args.source_commit,
        "build_id": args.build_id,
        "image_reference": args.image_reference,
        "image_id": observed["image_id"],
        "manifest_digest": observed["digest"],
        "repo_digests": observed["repo_digests"],
        "verified_labels": observed["labels"],
        "build_invocation": {
            "entrypoint": "tools/build-release-oci",
            "context": "repository-root",
            "containerfile_sha256": args.containerfile_sha256,
            "wrapper_sha256": args.wrapper_sha256,
        },
        "builder": {"podman_version": args.podman_version},
        "trust": "trusted-local-build-host; no cryptographic attestation",
    }
    args.output.parent.mkdir(parents=True, exist_ok=True)
    args.output.write_text(json.dumps(record, indent=2, sort_keys=True) + "\n")


def verify(args: argparse.Namespace) -> None:
    if not COMMIT.fullmatch(args.source_commit):
        raise EvidenceError("source commit must be exactly 40 lowercase hexadecimal characters")
    record = load_json(args.record)
    if not isinstance(record, dict) or record.get("schema") != SCHEMA or record.get("release_intent") is not True:
        raise EvidenceError("missing or malformed release evidence record")
    expected = {
        "planned_os_version": args.planned_version,
        "source_commit": args.source_commit,
        "image_reference": args.image_reference,
    }
    for name, value in expected.items():
        if record.get(name) != value:
            raise EvidenceError(f"release evidence {name}: expected {value!r}, found {record.get(name)!r}")
    invocation = record.get("build_invocation")
    if not isinstance(invocation, dict) or invocation.get("entrypoint") != "tools/build-release-oci" or invocation.get("context") != "repository-root":
        raise EvidenceError("release evidence has no controlled build invocation identity")
    for name in ("containerfile_sha256", "wrapper_sha256"):
        if not isinstance(invocation.get(name), str) or not HEX256.fullmatch(invocation[name]):
            raise EvidenceError(f"release evidence has no valid {name}")
    builder = record.get("builder")
    if not isinstance(builder, dict) or not isinstance(builder.get("podman_version"), str) or not builder["podman_version"]:
        raise EvidenceError("release evidence has no builder identity")
    if record.get("trust") != "trusted-local-build-host; no cryptographic attestation":
        raise EvidenceError("release evidence trust scope is missing or changed")
    build_id = record.get("build_id")
    if not isinstance(build_id, str):
        raise EvidenceError("release evidence has no BUILD_ID")
    observed = inspection(args.inspection)
    validate_identity(observed, args.planned_version, args.source_commit, build_id)
    if record.get("image_id") != observed["image_id"]:
        raise EvidenceError("selected image immutable ID differs from release evidence")
    if record.get("verified_labels") != observed["labels"]:
        raise EvidenceError("selected image labels differ from release evidence")
    for key, observed_key in (("manifest_digest", "digest"), ("repo_digests", "repo_digests")):
        if record.get(key) != observed[observed_key]:
            raise EvidenceError(f"selected image {key} differs from release evidence")


def parser() -> argparse.ArgumentParser:
    result = argparse.ArgumentParser(description=__doc__)
    sub = result.add_subparsers(dest="command", required=True)
    common = argparse.ArgumentParser(add_help=False)
    common.add_argument("--inspection", type=Path, required=True)
    common.add_argument("--planned-version", required=True)
    common.add_argument("--source-commit", required=True)
    common.add_argument("--image-reference", required=True)
    create_parser = sub.add_parser("create", parents=[common])
    create_parser.add_argument("--output", type=Path, required=True)
    create_parser.add_argument("--build-id", required=True)
    create_parser.add_argument("--containerfile-sha256", required=True)
    create_parser.add_argument("--wrapper-sha256", required=True)
    create_parser.add_argument("--podman-version", required=True)
    verify_parser = sub.add_parser("verify", parents=[common])
    verify_parser.add_argument("--record", type=Path, required=True)
    return result


def main() -> int:
    args = parser().parse_args()
    try:
        create(args) if args.command == "create" else verify(args)
    except EvidenceError as error:
        print(f"release-evidence: FAIL: {error}", file=sys.stderr)
        return 1
    print(f"release-evidence: PASS: {args.command}")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
