#!/usr/bin/env bash
# Explicit release-intent entry point. Developer builds may invoke Podman directly.
set -Eeuo pipefail

repo_root=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)
if (( $# == 0 )); then
    echo "Usage: $0 <planned-os-version> [--tag <image-reference>]" >&2
    exit 2
fi
planned_os_version=$1
shift
tag_arguments=()
while (( $# > 0 )); do
    case "$1" in
        -t|--tag)
            if (( $# < 2 )) || [[ -z $2 || $2 == -* ]]; then
                echo "$1 requires a nonempty image reference." >&2
                exit 2
            fi
            tag_arguments+=(--tag "$2")
            shift 2
            ;;
        *)
            echo "Unsupported release build argument: $1" >&2
            echo "Usage: $0 <planned-os-version> [--tag <image-reference>]" >&2
            exit 2
            ;;
    esac
done
python3 "$repo_root/tools/coreos-inventory" --root "$repo_root"
python3 "$repo_root/tools/release-preflight" "$planned_os_version" --root "$repo_root"
command -v podman >/dev/null || { echo "Missing required tool: podman" >&2; exit 1; }
exec podman build \
    --file "$repo_root/Containerfile" \
    --build-arg RELEASE_INTENT=release \
    --build-arg "PLANNED_OS_VERSION=$planned_os_version" \
    "${tag_arguments[@]}" \
    "$repo_root"
