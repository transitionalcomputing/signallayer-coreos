#!/usr/bin/env bash
# Explicit release-intent entry point. Developer builds may invoke Podman directly.
set -Eeuo pipefail

repo_root=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)
if (( $# == 0 )); then
    echo "Usage: $0 <planned-os-version> [podman build arguments...]" >&2
    exit 2
fi
planned_os_version=$1
shift
for argument in "$@"; do
    case "$argument" in
        *RELEASE_INTENT*|*PLANNED_OS_VERSION*)
            echo "Release intent arguments are owned by $0 and may not be overridden." >&2
            exit 2
            ;;
    esac
done
python3 "$repo_root/tools/coreos-inventory" --root "$repo_root"
python3 "$repo_root/tools/release-preflight" "$planned_os_version" --root "$repo_root"
command -v podman >/dev/null || { echo "Missing required tool: podman" >&2; exit 1; }
exec podman build \
    --build-arg RELEASE_INTENT=release \
    --build-arg "PLANNED_OS_VERSION=$planned_os_version" \
    "$@"
