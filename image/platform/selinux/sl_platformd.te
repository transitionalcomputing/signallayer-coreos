policy_module(sl_platformd, 0.1.0)

# The management-facing session service is a separate unprivileged domain. It
# can use the system bus and exchange messages with the read-only Platform
# service, but receives no machine inspection, mutation, capability, or unit
# control permissions.
type sl_sessiond_t;
type sl_sessiond_exec_t;
init_daemon_domain(sl_sessiond_t, sl_sessiond_exec_t)
gen_require(`
    type init_t;
')
domtrans_pattern(init_t, sl_sessiond_exec_t, sl_sessiond_t)
allow init_t sl_sessiond_t:process2 nnp_transition;

libs_use_ld_so(sl_sessiond_t)
libs_use_shared_libs(sl_sessiond_t)
files_read_usr_files(sl_sessiond_t)
miscfiles_read_localization(sl_sessiond_t)
dev_read_urand(sl_sessiond_t)
dbus_system_bus_client(sl_sessiond_t)
gen_require(`
    class dbus acquire_svc;
')
allow sl_sessiond_t self:dbus acquire_svc;

# NetworkManager observation is isolated in an unprivileged daemon. Its bus
# policy permits only Properties.Get, while SELinux limits its peers to
# Platform and NetworkManager. It receives no capabilities or mutation access.
type sl_network_observer_t;
type sl_network_observer_exec_t;
init_daemon_domain(sl_network_observer_t, sl_network_observer_exec_t)
domtrans_pattern(init_t, sl_network_observer_exec_t, sl_network_observer_t)
allow init_t sl_network_observer_t:process2 nnp_transition;

libs_use_ld_so(sl_network_observer_t)
libs_use_shared_libs(sl_network_observer_t)
files_read_usr_files(sl_network_observer_t)
miscfiles_read_localization(sl_network_observer_t)
dev_read_urand(sl_network_observer_t)
dbus_system_bus_client(sl_network_observer_t)
allow sl_network_observer_t self:dbus acquire_svc;

# The authentication service is a separate unprivileged domain with one
# private persistent state directory. It exchanges messages only with its
# existing callers (Platform and the session service); the remote-management
# and console domains are added with those services in 5C-b.
type sl_authd_t;
type sl_authd_exec_t;
init_daemon_domain(sl_authd_t, sl_authd_exec_t)
domtrans_pattern(init_t, sl_authd_exec_t, sl_authd_t)
allow init_t sl_authd_t:process2 nnp_transition;

libs_use_ld_so(sl_authd_t)
libs_use_shared_libs(sl_authd_t)
files_read_usr_files(sl_authd_t)
miscfiles_read_localization(sl_authd_t)
dev_read_urand(sl_authd_t)
# Rust available_parallelism reads cgroup CPU quota information at startup.
fs_read_cgroup_files(sl_authd_t)
dbus_system_bus_client(sl_authd_t)
allow sl_authd_t self:dbus acquire_svc;

# Only sl_authd_t writes its state. PID 1 creates and chowns the directory for
# StateDirectory=sl-authd; it receives no file access inside it.
type sl_authd_var_lib_t;
files_type(sl_authd_var_lib_t)
files_search_var_lib(sl_authd_t)
manage_files_pattern(sl_authd_t, sl_authd_var_lib_t, sl_authd_var_lib_t)
allow init_t sl_authd_var_lib_t:dir { create_dir_perms setattr relabelto };

# Remote-management state (5C-b). sl_remote_worker_t, running the fixed
# sl-remote-worker modes, is the only writer. Platform and Session1 get
# read-only access below, and never the private key. sl-remoted (5C-c) and
# sl-console (5C-d) domains, and their rules, are added in those phases.
type sl_rm_state_t;
files_type(sl_rm_state_t)
type sl_rm_tls_t;
files_type(sl_rm_tls_t)
type sl_rm_tls_key_t;
files_type(sl_rm_tls_key_t)
# PID 1 creates /var/lib/sl-remote-management for StateDirectory=.
allow init_t sl_rm_state_t:dir { create_dir_perms setattr relabelto };

type sl_remote_worker_t;
type sl_remote_worker_exec_t;
init_daemon_domain(sl_remote_worker_t, sl_remote_worker_exec_t)
domtrans_pattern(init_t, sl_remote_worker_exec_t, sl_remote_worker_t)
allow init_t sl_remote_worker_t:process2 nnp_transition;

libs_use_ld_so(sl_remote_worker_t)
libs_use_shared_libs(sl_remote_worker_t)
files_read_usr_files(sl_remote_worker_t)
miscfiles_read_localization(sl_remote_worker_t)
dev_read_urand(sl_remote_worker_t)
# The sl-remoted group lookup for TLS file ownership.
auth_read_passwd_file(sl_remote_worker_t)
# TLS files are chowned to root:sl-remoted.
allow sl_remote_worker_t self:capability chown;

# The fixed /usr/bin/openssl, run without a domain transition, reading only
# the public config copy (OPENSSL_CONF) and the system crypto policy.
corecmd_exec_bin(sl_remote_worker_t)
allow sl_remote_worker_t self:process { fork sigchld };
allow sl_remote_worker_t self:fifo_file rw_fifo_file_perms;
files_read_etc_files(sl_remote_worker_t)
miscfiles_search_generic_cert_dirs(sl_remote_worker_t)
kernel_read_crypto_sysctls(sl_remote_worker_t)
allow sl_remote_worker_t sl_platformd_release_t:dir list_dir_perms;
allow sl_remote_worker_t sl_platformd_release_t:file read_file_perms;

files_search_var_lib(sl_remote_worker_t)
manage_dirs_pattern(sl_remote_worker_t, sl_rm_state_t, sl_rm_state_t)
manage_files_pattern(sl_remote_worker_t, sl_rm_state_t, sl_rm_state_t)
manage_dirs_pattern(sl_remote_worker_t, sl_rm_state_t, sl_rm_tls_t)
manage_dirs_pattern(sl_remote_worker_t, sl_rm_tls_t, sl_rm_tls_t)
manage_files_pattern(sl_remote_worker_t, sl_rm_tls_t, sl_rm_tls_t)
manage_lnk_files_pattern(sl_remote_worker_t, sl_rm_tls_t, sl_rm_tls_t)
manage_files_pattern(sl_remote_worker_t, sl_rm_tls_t, sl_rm_tls_key_t)
# Created objects get their frozen types by name.
type_transition sl_remote_worker_t sl_rm_state_t:dir sl_rm_tls_t "tls";
type_transition sl_remote_worker_t sl_rm_tls_t:file sl_rm_tls_key_t "key.pem";
# PID 1 evaluates the fixed sl-remoted ConditionPathExists against `current`.
allow init_t sl_rm_tls_t:lnk_file read_lnk_file_perms;

# The boot reset calls sl-authd's ResetEnrollment over the system bus.
dbus_system_bus_client(sl_remote_worker_t)
allow sl_remote_worker_t sl_authd_t:dbus send_msg;
allow sl_authd_t sl_remote_worker_t:dbus send_msg;

# Worker unit files. Platform may start and observe the four lifecycle
# workers. The boot-reset unit has its own type with no Platform permission,
# so Platform cannot trigger a destructive reset.
type sl_rm_worker_unit_file_t;
systemd_unit_file(sl_rm_worker_unit_file_t)
type sl_rm_boot_reset_unit_file_t;
systemd_unit_file(sl_rm_boot_reset_unit_file_t)

# sl-remoted (5C-c): the unprivileged, read-only HTTPS service. Its only bus
# peers are sl-authd and sl-sessiond.
type sl_remoted_t;
type sl_remoted_exec_t;
init_daemon_domain(sl_remoted_t, sl_remoted_exec_t)
domtrans_pattern(init_t, sl_remoted_exec_t, sl_remoted_t)
allow init_t sl_remoted_t:process2 nnp_transition;

libs_use_ld_so(sl_remoted_t)
libs_use_shared_libs(sl_remoted_t)
files_read_usr_files(sl_remoted_t)
miscfiles_read_localization(sl_remoted_t)
dev_read_urand(sl_remoted_t)
# Rust available_parallelism reads cgroup CPU quota information at startup.
fs_read_cgroup_files(sl_remoted_t)
dbus_system_bus_client(sl_remoted_t)
allow sl_remoted_t sl_authd_t:dbus send_msg;
allow sl_authd_t sl_remoted_t:dbus send_msg;
allow sl_remoted_t sl_sessiond_t:dbus send_msg;
allow sl_sessiond_t sl_remoted_t:dbus send_msg;

# The current TLS identity, including its key. Read only.
files_search_var_lib(sl_remoted_t)
allow sl_remoted_t sl_rm_state_t:dir search_dir_perms;
allow sl_remoted_t sl_rm_tls_t:dir search_dir_perms;
allow sl_remoted_t sl_rm_tls_t:lnk_file read_lnk_file_perms;
allow sl_remoted_t sl_rm_tls_t:file read_file_perms;
allow sl_remoted_t sl_rm_tls_key_t:file read_file_perms;

# HTTPS on 8443 (http_port_t), bound to specific addresses.
allow sl_remoted_t self:tcp_socket create_stream_socket_perms;
corenet_tcp_bind_generic_node(sl_remoted_t)
corenet_tcp_bind_http_port(sl_remoted_t)
corenet_tcp_sendrecv_generic_if(sl_remoted_t)
corenet_tcp_sendrecv_generic_node(sl_remoted_t)
corenet_tcp_sendrecv_http_port(sl_remoted_t)
# rtnetlink change notifications: its own socket, bound to multicast groups,
# received only. No netlink request is ever sent (no nlmsg_read/nlmsg_write).
allow sl_remoted_t self:netlink_route_socket { create bind read };

# /run/sl-remoted (RuntimeDirectory=) and its listening marker. PID 1 creates
# and removes the directory; Session1 checks only the marker's presence.
type sl_remoted_runtime_t;
files_pid_file(sl_remoted_runtime_t)
files_search_pids(sl_remoted_t)
allow init_t sl_remoted_runtime_t:dir { manage_dir_perms relabelto };
allow init_t sl_remoted_runtime_t:file delete_file_perms;
manage_files_pattern(sl_remoted_t, sl_remoted_runtime_t, sl_remoted_runtime_t)
allow sl_sessiond_t sl_remoted_runtime_t:dir search_dir_perms;
allow sl_sessiond_t sl_remoted_runtime_t:file getattr;

# The trusted local appliance console is unprivileged and has no filesystem,
# process-management, capability or network authority. systemd opens its exact
# TTYPath before dropping privileges; the domain can use only inherited
# terminal descriptors. D-Bus policy independently restricts exact members.
type sl_console_t;
type sl_console_exec_t;
init_daemon_domain(sl_console_t, sl_console_exec_t)
domtrans_pattern(init_t, sl_console_exec_t, sl_console_t)
allow init_t sl_console_t:process2 nnp_transition;

libs_use_ld_so(sl_console_t)
libs_use_shared_libs(sl_console_t)
files_read_usr_files(sl_console_t)
miscfiles_read_localization(sl_console_t)
fs_read_cgroup_files(sl_console_t)
dbus_system_bus_client(sl_console_t)
term_use_all_inherited_terms(sl_console_t)
allow sl_console_t sl_authd_t:dbus send_msg;
allow sl_authd_t sl_console_t:dbus send_msg;
allow sl_console_t sl_platformd_t:dbus send_msg;
allow sl_platformd_t sl_console_t:dbus send_msg;
allow sl_console_t sl_sessiond_t:dbus send_msg;
allow sl_sessiond_t sl_console_t:dbus send_msg;

type sl_console_unit_file_t;
systemd_unit_file(sl_console_unit_file_t)

# Platform starts, stops and observes sl-remoted (Enable, Disable, Reenroll).
type sl_remoted_unit_file_t;
systemd_unit_file(sl_remoted_unit_file_t)
allow sl_platformd_t sl_remoted_unit_file_t:service { start stop status };

# PID 1 transitions on the image-owned entry point. No permissive/unconfined
# attribute is assigned to this domain or its inherited bootc children.
type sl_platformd_t;
type sl_platformd_exec_t;
init_daemon_domain(sl_platformd_t, sl_platformd_exec_t)
gen_require(`
    type init_t;
')
domtrans_pattern(init_t, sl_platformd_exec_t, sl_platformd_t)
allow init_t sl_platformd_t:process2 nnp_transition;

# PID 1 checks the unit-file label for service control. Platformd can start and
# observe this one image-owned unit type, not generic systemd units.
type sl_update_unit_file_t;
systemd_unit_file(sl_update_unit_file_t)
allow sl_platformd_t sl_update_unit_file_t:service { start status };

# The fixed reboot worker has its own unit-file type, so reboot authority stays
# separate from the deployment workers. Platformd may only start and observe it.
type sl_reboot_unit_file_t;
systemd_unit_file(sl_reboot_unit_file_t)
allow sl_platformd_t sl_reboot_unit_file_t:service { start status };

# Bootc creates staged state with O_TMPFILE, before a basename exists. Keep its
# runtime directory distinct, then transition regular files created there by
# Fedora's trusted install_t update domain. This does not expose generic /run
# files or externally provisioned /run/ostree/auth.json credentials.
type sl_bootc_runtime_t;
files_pid_file(sl_bootc_runtime_t)
type sl_bootc_state_t;
files_pid_file(sl_bootc_state_t)
gen_require(`
    type install_t;
')
allow install_t sl_bootc_runtime_t:dir manage_dir_perms;
type_transition install_t sl_bootc_runtime_t:file sl_bootc_state_t;
allow install_t sl_bootc_state_t:file manage_file_perms;
allow sl_platformd_t sl_bootc_runtime_t:dir search_dir_perms;
allow sl_platformd_t sl_bootc_state_t:file read_file_perms;

type sl_platformd_release_t;
files_type(sl_platformd_release_t)
allow sl_platformd_t sl_platformd_release_t:dir list_dir_perms;
allow sl_platformd_t sl_platformd_release_t:file read_file_perms;

# Rust runtime, dynamic loader, localization and ordinary read-only image data.
libs_use_ld_so(sl_platformd_t)
libs_use_shared_libs(sl_platformd_t)
files_read_usr_files(sl_platformd_t)
files_read_etc_files(sl_platformd_t)
miscfiles_read_localization(sl_platformd_t)
# The status backend traverses the system PKI directory during initialization.
# Fedora also labels generic TLS keys cert_t; grant directory search only.
miscfiles_search_generic_cert_dirs(sl_platformd_t)
dev_read_urand(sl_platformd_t)
# Rust available_parallelism reads cgroup CPU quota information at startup.
fs_read_cgroup_files(sl_platformd_t)

# The only command is the fixed bootc status backend; it remains in this domain.
gen_require(`
    type install_exec_t;
')
can_exec(sl_platformd_t, install_exec_t)
# The fixed backend must be killed on its deadline or output overflow.
allow sl_platformd_t self:process { fork sigchld signal sigkill };
allow sl_platformd_t self:fifo_file rw_fifo_file_perms;
allow sl_platformd_t self:capability { sys_admin sys_ptrace };
# Fedora 44 bootc captures its findmnt helper's output in a memfd, which is
# labeled tmpfs_t; these are exactly the permissions the 0.0.3 RC denied.
gen_require(`
    type tmpfs_t;
')
allow sl_platformd_t tmpfs_t:file { getattr ioctl read write };

# Public, read-only system-bus service plus observed systemd health properties.
dbus_system_bus_client(sl_platformd_t)
# The XML associates only org.signallayer.Platform1 with this service SID.
gen_require(`
    class dbus acquire_svc;
')
allow sl_platformd_t self:dbus acquire_svc;
init_dbus_chat(sl_platformd_t)
allow sl_sessiond_t sl_platformd_t:dbus send_msg;
allow sl_platformd_t sl_sessiond_t:dbus send_msg;
allow sl_platformd_t sl_authd_t:dbus send_msg;
allow sl_authd_t sl_platformd_t:dbus send_msg;
allow sl_sessiond_t sl_authd_t:dbus send_msg;
allow sl_authd_t sl_sessiond_t:dbus send_msg;
# Remote management: Platform starts and observes the lifecycle workers,
# checks the markers, and reads the current identity's fingerprint, never
# the key. Its sl-remoted unit permissions are with sl-remoted above.
allow sl_platformd_t sl_rm_worker_unit_file_t:service { start status };
files_search_var_lib(sl_platformd_t)
allow sl_platformd_t sl_rm_state_t:dir search_dir_perms;
allow sl_platformd_t sl_rm_state_t:file getattr;
allow sl_platformd_t sl_rm_tls_t:dir search_dir_perms;
allow sl_platformd_t sl_rm_tls_t:lnk_file read_lnk_file_perms;
allow sl_platformd_t sl_rm_tls_t:file read_file_perms;
# Session1 checks only the presence of the enabled marker. The lookup of
# /run/sl-remoted/listening needs /run search; the marker's own rules are
# with sl-remoted above.
files_search_var_lib(sl_sessiond_t)
allow sl_sessiond_t sl_rm_state_t:dir search_dir_perms;
allow sl_sessiond_t sl_rm_state_t:file getattr;
files_search_pids(sl_sessiond_t)
# Platform talks only to the network observer; it has no direct NetworkManager
# message permission. The observer's system-bus policy further restricts its
# unprivileged identity to the Properties.Get member.
allow sl_platformd_t sl_network_observer_t:dbus send_msg;
allow sl_network_observer_t sl_platformd_t:dbus send_msg;
gen_require(`
    type NetworkManager_t;
')
allow sl_network_observer_t NetworkManager_t:dbus send_msg;
allow NetworkManager_t sl_network_observer_t:dbus send_msg;
# PID 1 separately checks status permission for read-only Manager properties.
# bootc also stats packaged units: metadata only, without unit contents/control.
init_status(sl_platformd_t)
systemd_getattr_unit_files(sl_platformd_t)
logging_send_syslog_msg(sl_platformd_t)

# The pinned backend detects a booted OSTree host from its runtime marker.
gen_require(`
    type install_var_run_t;
')
allow sl_platformd_t install_var_run_t:file read_file_perms;

# bootc compares the PID 1 mount namespace and inspects SELinux state.
kernel_read_system_state(sl_platformd_t)
# Its deployment inspection queries statfs on the persistent root filesystem.
# Metadata only: no filesystem mount, relabel or write permission is added.
fs_getattr_xattr_fs(sl_platformd_t)
# The pinned status path remounts /sysroot only after entering its private
# namespace. Execute the fixed mount helper without a domain transition.
mount_exec(sl_platformd_t)
fs_remount_xattr_fs(sl_platformd_t)
# findmnt/lsblk inspect udev's database and device metadata. Do not grant raw
# block reads: those can bypass file-level SELinux confinement.
udev_read_db(sl_platformd_t)
storage_getattr_fixed_disk_dev(sl_platformd_t)
# lsblk resolves public device owner/group names and reads libmount's cache.
# Do not use auth_read_passwd: its optional SSSD IPC is unnecessary here.
auth_read_passwd_file(sl_platformd_t)
mount_read_pid_files(sl_platformd_t)

# libostree status takes an exclusive ostree/lock, then unlinks it on release.
# Bootc bootstraps the physical /ostree as usr_t; the disk build labels only
# that directory from this image's policy after installation. Retain Fedora's
# public base-directory readers, without assigning executable/mount attributes.
type sl_platformd_ostree_t;
files_ro_base_file(sl_platformd_ostree_t)
type sl_platformd_lock_t;
files_type(sl_platformd_lock_t)
allow sl_platformd_t sl_platformd_ostree_t:dir { list_dir_perms write add_name remove_name };
allow sl_platformd_t sl_platformd_lock_t:file { create getattr open read write lock unlink };
gen_require(`
    attribute domain;
')
# Keep ordinary root bootc and the confined backend on the same lock type.
# Only this basename transitions; the daemon cannot create the directory type
# as files, nor write/create ordinary usr_t deployment/repository files.
type_transition domain sl_platformd_ostree_t:file sl_platformd_lock_t "lock";
# Namespace inspection needs PID 1 directory traversal and namespace-link
# reads as well as the PTRACE_MODE_READ file check. This maintained interface
# grants read-only process state, not attach/trace. Linux bounds stay unchanged.
init_read_state(sl_platformd_t)
selinux_get_enforce_mode(sl_platformd_t)

# bootc's supported SELinux preflight creates a private temporary file, invokes
# chcon, then copies/relabels/re-execs itself when the invalid-label test fails.
# CAP_MAC_ADMIN stays absent: no SELinux-administration permission is granted.
# Re-execution of install_exec_t stays in sl_platformd_t (no install_t transition).
type sl_platformd_tmp_t;
files_tmp_file(sl_platformd_tmp_t)
files_tmp_filetrans(sl_platformd_t, sl_platformd_tmp_t, { dir file })
allow sl_platformd_t sl_platformd_tmp_t:dir manage_dir_perms;
allow sl_platformd_t sl_platformd_tmp_t:file { manage_file_perms relabelfrom };
allow sl_platformd_t install_exec_t:file { relabelto unlink setattr };
corecmd_exec_bin(sl_platformd_t)
gen_require(`
    type selinux_config_t;
')
allow sl_platformd_t selinux_config_t:dir list_dir_perms;
allow sl_platformd_t selinux_config_t:file mmap_read_file_perms;
allow sl_platformd_t selinux_config_t:lnk_file read_lnk_file_perms;

seutil_read_file_contexts(sl_platformd_t)
# The pinned preflight computes its checksum from the installed module store.
# This interface lists/reads the store; it does not manage or load policy.
seutil_read_module_store(sl_platformd_t)
