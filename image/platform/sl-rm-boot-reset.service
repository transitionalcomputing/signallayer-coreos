[Unit]
Description=SignalLayerIT remote-management boot-time reset worker
ConditionKernelCommandLine=signallayer.remote-management-reset
Requires=sl-authd.service
After=sl-authd.service
Before=sl-remoted.service sl-console.service sl-sessiond.service sl-platformd.service

[Service]
Type=oneshot
ExecStart=/usr/libexec/signallayer/sl-remote-worker boot-reset
User=root
StateDirectory=sl-remote-management
StateDirectoryMode=0755
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
PrivateDevices=yes
PrivateNetwork=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictAddressFamilies=AF_UNIX
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
UMask=0077

[Install]
WantedBy=multi-user.target
