[Unit]
Description=SignalLayerIT unprivileged authentication service
After=dbus.service
Requires=dbus.service

[Service]
Type=dbus
BusName=org.signallayer.Auth1
ExecStart=/usr/bin/sl-authd
User=sl-authd
Group=sl-authd
StateDirectory=sl-authd
StateDirectoryMode=0700
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
PrivateDevices=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_UNIX
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
UMask=0077

[Install]
WantedBy=multi-user.target
